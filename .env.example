MCP_TRANSPORT=http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
# Public HTTPS origin in production. Use 127.0.0.1 (not localhost) locally.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate once with: openssl rand -hex 32. Keep stable across deployments.
BETTER_AUTH_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Register BETTER_AUTH_URL + /api/auth/callback/spotify in Spotify's dashboard.
DATABASE_PATH=./data/spotify.sqlite
# Optional, only for trusted local stdio clients: Better Auth user ID.
# SPOTIFY_LOCAL_USER_ID=
